{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "dist",
    "lib": ["ES2018", "DOM"]
  },
  "include": ["src/**/*"]
}
